<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen theme -->
    <style name="Theme.LocalJobFinder.Splash" parent="Theme.SplashScreen">
        <!-- Match background to your custom splash background -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <!-- Hide the default app icon -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Speed up the transition to custom splash -->
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.LocalJobFinder</item>
    </style>

    <!-- Base application theme -->
    <style name="Theme.LocalJobFinder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/is_light_status_bar</item>
    </style>
</resources>
